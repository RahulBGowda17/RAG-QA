# RAG-QA Environment Configuration
FLASK_ENV=development
DEBUG=True
PORT=5000
HOST=127.0.0.1
SECRET_KEY=rag-qa-super-secret-academic-dev-key

# Storage & Paths
DATA_DIR=data
UPLOAD_DIR=data/uploads
INDEX_DIR=data/indices
DATABASE_PATH=data/rag_qa.db
FAISS_INDEX_PATH=data/indices/faiss_index.bin

# Ingestion & Chunking Limits
MAX_UPLOAD_SIZE_MB=16
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval & NLP Models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval Hyperparameters
DENSE_TOP_K=10
BM25_TOP_K=10
CANDIDATE_POOL_SIZE=15
RERANK_TOP_K=4
EVIDENCE_THRESHOLD=0.05

# LLM Provider Configuration (options: local_mock, ollama, openai_compatible)
LLM_PROVIDER=local_mock
LLM_MODEL_NAME=phi3:mini
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=none
MAX_CONTEXT_TOKENS=2000
TEMPERATURE=0.1
